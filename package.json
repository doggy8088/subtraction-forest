{
  "name": "subtraction-forest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot scripts/serve.ts",
    "build": "bun run typecheck && bun scripts/build.ts",
    "preview": "bun scripts/serve.ts --preview",
    "test": "bun test",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "format": "bunx --bun prettier --write .",
    "format:check": "bunx --bun prettier --check .",
    "check:site": "bun scripts/check-site.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "axe-core": "^4.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13"
}
